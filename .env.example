# ============================================================
#  CYBERLABX — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to git
# ============================================================

# Server
PORT=3000

# JWT Secret — change this to a long random string in production
JWT_SECRET=cyberlabx_change_this_to_a_long_random_secret_string_in_production

# Optional: OAuth credentials (uncomment when you add passport.js)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
